*
* STANDARD ERROR MESSAGE LIST
*
EQU ERR_MSGS TO 31
EQU ERR_WARN TO 0    ;* WARNING
EQU ERR_BUSY TO 1    ;* FILE BUSY (COULD NOT UPDATE LOCK RECORD)
EQU ERR_NOF  TO 2    ;* RECORD NOT ON FILE
EQU ERR_NOTE TO 3    ;* NOTICE
EQU ERR_SYS  TO 30 ;* SYSTEM ERROR
EQU ERR_GUI  TO 31 ;* GUI SYTEM ERROR
*
DIM ERR_MESSAGE(ERR_MSGS)
ERR_MESSAGE(ERR_BUSY) = "Unable To Update Lock Record"
ERR_MESSAGE(ERR_NOF) = "Record Not On File"
ERR_MESSAGE(ERR_SYS) = "SYSTEM error see log file"
ERR_MESSAGE(ERR_GUI) = "GUI System error"
ERR_MESSAGE(ERR_NOTE) = "Notice..."