SUBROUTINE GUI.SEARCH2 (F.NAME,USEARCH.FLD,USEARCH.STR,USORT,DISP.FLDS,MAX.LIST,START.LIST,LST.LNS,LST.IDX,LIST.CT,OPTIONS,EMSG)
!
