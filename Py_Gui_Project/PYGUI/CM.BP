$include KEYS.H
$include SDPYFUNC.H
$CATALOGUE CM.BP LOCAL

lf = char(10)   ;* line feed character
DEFFUN values_load(val_window,val_obj_key,val_list_name,dyn_list) LOCAL

* These should be generated using the sd GENERATE command. For now we are doing this manually
* Also may want to modify GENERATE for create the xx_DICT and xx_KEY dyn arrays

equate CM_NAME to 1
equate CM_ADDR          to    2
equate CM_ADDR2         to    3
equate CM_CITY          to    4
equate CM_STATE         to    5
equate CM_ZIP           to    6
equate CM_COUNTRY       to    7
equate CM_STATUS        to    8
equate CM_AR_LIMIT      to    9
equate CM_TERMS         to    10
equate CM_PHONE         to    11
equate CM_FAX           to    12
equate CM_WEB           to    13
equate CM_CONTACT       to    14
equate CM_CONTACT_PHONE to    15
equate CM_CONTACT_EMAIL to    16
equate CM_DFLT_SHIP_ID  to    17
equate CM_REP           to    18
equate CM_SIZE  to    18

equate CS_NAME to 1
equate CS_ADDR          to    2
equate CS_ADDR2         to    3
equate CS_CITY          to    4
equate CS_STATE         to    5
equate CS_ZIP           to    6
equate CS_COUNTRY       to    7
equate CS_STATUS        to    8
equate CS_PHONE         to    9
equate CS_FAX           to    10
equate CS_SIZE to    10

*
* It is very important that the KEY and DICT arrays are sized the same (one entry for each record's data field)
* And that the ordering matches the field position within the data record.
* Again, this is something the GENERATE command could do for us!
*
* CUSTOMER record
* 
CM_KEY_NAME = ''
CM_KEY_NAME<CM_NAME> = "CM_NAME"
CM_KEY_NAME<CM_ADDR> = "CM_ADDR"
CM_KEY_NAME<CM_ADDR2> = "CM_ADDR2"
CM_KEY_NAME<CM_CITY> = "CM_CITY"
CM_KEY_NAME<CM_STATE> = "CM_STATE"
CM_KEY_NAME<CM_ZIP> = "CM_ZIP"
CM_KEY_NAME<CM_COUNTRY> = "CM_COUNTRY"
CM_KEY_NAME<CM_STATUS> = "CM_STATUS"
CM_KEY_NAME<CM_AR_LIMIT> = "CM_AR_LIMIT"
CM_KEY_NAME<CM_TERMS> = "CM_TERMS"
CM_KEY_NAME<CM_PHONE> = "CM_PHONE"
CM_KEY_NAME<CM_FAX> = "CM_FAX"
CM_KEY_NAME<CM_WEB> = "CM_WEB"
*
* the following tells the code that these data items will be loaded into a table
* number at vm pos 3 tells us the col position within a row
*
* rem we treat all mv flds as tables, a mv field not associated with other fields would just be a table with 1 column of data
*
*                                 key         table#  Col#
CM_KEY_NAME<CM_CONTACT> =       "CM_CONTACT":@VM:1:@VM:1
CM_KEY_NAME<CM_CONTACT_PHONE> = "CM_CONTACT":@VM:1:@VM:2
CM_KEY_NAME<CM_CONTACT_EMAIL> = "CM_CONTACT":@VM:1:@VM:3
CM_KEY_NAME<CM_DFLT_SHIP_ID> = "CM_DFLT_SHIP_ID"
CM_KEY_NAME<CM_REP>          = "CM_REP" 

CM_DICT_NAME = ''
CM_DICT_NAME<CM_NAME> = "CM_NAME"
CM_DICT_NAME<CM_ADDR> = "CM_ADDR"
CM_DICT_NAME<CM_ADDR2> = "CM_ADDR2"
CM_DICT_NAME<CM_CITY> = "CM_CITY"
CM_DICT_NAME<CM_STATE> = "CM_STATE"
CM_DICT_NAME<CM_ZIP> = "CM_ZIP"
CM_DICT_NAME<CM_COUNTRY> = "CM_COUNTRY"
CM_DICT_NAME<CM_STATUS> = "CM_STATUS"
CM_DICT_NAME<CM_AR_LIMIT> = "CM_AR_LIMIT"
CM_DICT_NAME<CM_TERMS> = "CM_TERMS"
CM_DICT_NAME<CM_PHONE> = "CM_PHONE"
CM_DICT_NAME<CM_FAX> = "CM_FAX"
CM_DICT_NAME<CM_WEB> = "CM_WEB"
CM_DICT_NAME<CM_CONTACT> = "CM_CONTACT"
CM_DICT_NAME<CM_CONTACT_PHONE> = "CM_CONTACT_PHONE"
CM_DICT_NAME<CM_CONTACT_EMAIL> = "CM_CONTACT_EMAIL"
CM_DICT_NAME<CM_DFLT_SHIP_ID> = "CM_DFLT_SHIP_ID" 
CM_DICT_NAME<CM_REP>          = "CM_REP"

* SHIP_TO records
*
CS_KEY_NAME = ''
CS_KEY_NAME<CS_NAME> = "CS_NAME"
CS_KEY_NAME<CS_ADDR> = "CS_ADDR"
CS_KEY_NAME<CS_ADDR2> = "CS_ADDR2"
CS_KEY_NAME<CS_CITY> = "CS_CITY"
CS_KEY_NAME<CS_STATE> = "CS_STATE"
CS_KEY_NAME<CS_ZIP> = "CS_ZIP"
CS_KEY_NAME<CS_COUNTRY> = "CS_COUNTRY"
CS_KEY_NAME<CS_STATUS> = "CS_STATUS"
CS_KEY_NAME<CS_PHONE> = "CS_PHONE"
CS_KEY_NAME<CS_FAX> = "CS_FAX"


CS_DICT_NAME = ''
CS_DICT_NAME<CS_NAME> = "CS_NAME"
CS_DICT_NAME<CS_ADDR> = "CS_ADDR"
CS_DICT_NAME<CS_ADDR2> = "CS_ADDR2"
CS_DICT_NAME<CS_CITY> = "CS_CITY"
CS_DICT_NAME<CS_STATE> = "CS_STATE"
CS_DICT_NAME<CS_ZIP> = "CS_ZIP"
CS_DICT_NAME<CS_COUNTRY> = "CS_COUNTRY"
CS_DICT_NAME<CS_STATUS> = "CS_STATUS"
CS_DICT_NAME<CS_PHONE> = "CS_PHONE"
CS_DICT_NAME<CS_FAX> = "CS_FAX"



* rem to point these to where you save the python scripts
SETUP.FILE = @PATH:"/PYGUI/py/CM.py"
openseq SETUP.FILE to SETUP.F else 
  crt 'Cannot open setup file: ':SETUP.FILE
  stop
end
*
close SETUP.F

* do the files exist?
open "CUSTOMERS" to CM_FILE ELSE
  crt 'CANNOT CREATE CUSTOMERS'
  stop
end
open "SHIP_TO" to CS_FILE ELSE
  crt 'CANNOT CREATE SHIP_TO'
  stop
end
OPEN 'NEXT_ID' to ID_FILE ELSE
  CRT 'CANNOT OPEN NEXT_ID'
  STOP
END

CM.REC = ''
CS_REC = ''

* get the dictionaries
equate GLOBAL_DICT_SZ to 50
dim global_dict_array(GLOBAL_DICT_SZ)
DIM CM_DICT(CM_SIZE)
DIM CS_DICT(CS_SIZE)
#define MAX_TABLES    5
DIM TABLES(MAX_TABLES)             ;* at some point we need to figure how to automate dim size

* grab dictionary records for CUSTOMERS
GOSUB pop_dict("CUSTOMERS",CM_DICT_NAME)
* rem cannot pass matrix in local sub
for i = 1 to CM_SIZE
  if i <= GLOBAL_DICT_SZ then
    CM_DICT(i) = global_dict_array(i)
  end else
    CRT 'Resize global_dict_array !!!'
  end
next i

* grab dictionary records for SHIP_TO
GOSUB pop_dict("SHIP_TO",CS_DICT_NAME)
for i = 1 to CS_SIZE
  if i <= GLOBAL_DICT_SZ then
    CS_DICT(i) = global_dict_array(i)
  end else
    CRT 'Resize global_dict_array !!!'
  end
next i

* all important python initialization
STATUS.VALUE = PY_INITIALIZE()
if STATUS.VALUE # 0 then
    crt "Python initialization failed: ":STATUS.VALUE
    stop
end
*
crt "loading common functions module sdgui_functions.py"
FUNC.FILE = @PATH:"/PYGUI/py/sdgui_functions.py"
STATUS.VALUE = PY_RUNFILE(FUNC.FILE)
if STATUS.VALUE # 0 then
    crt "PYGui functions load failed: ":STATUS.VALUE
    goto SHUTDOWN
end
*
crt "Setup Gui Window"
STATUS.VALUE = PY_RUNFILE(SETUP.FILE)
if STATUS.VALUE # 0 then
    crt "PYGui setup failed: ":STATUS.VALUE
    goto SHUTDOWN
end

* Load any dropdown lists here
*
* CREATE LISTS FOR  DROP DOWN CONTROLS
*
TERMS.LIST  = ''  ;* LIST FOR PAYMENT TERMS SELECTION
TERMS.IDX   = ''
STATES.LIST = ''  ;* LIST FOR STATE SELECTION
STATES.IDX  = ''
STATUS.LIST = ''  ;* LIST FOR CUSTOMER STATUS SELECTION
STATUS.IDX  = ''

CM.LIST = '[]'  ;* CUSTOMER LIST FOR CUSTOMER 
CM.LIST.IDX  = '[]'
CM.LIST.CT  = 0

GOSUB CM_LIST_LOAD
if rtn_stat # 0 then
  goto SHUTDOWN
end
*
MSG = 'Status: OK'
rtn_stat = PY_GUIWINUPDATE("main_window","-STATUS-",MSG)

**CALL LIST.LOAD(VAL.FVAR,"STATES","2",'',STATES.LIST,STATES.IDX,LIST.COUNT,EMSG)
**IF EMSG <> "" THEN GOTO EXIT.999
**CALL LIST.LOAD(VAL.FVAR,"TERMS","2",'',TERMS.LIST,TERMS.IDX,LIST.COUNT,EMSG)
**IF EMSG <> "" THEN GOTO EXIT.999
**CALL LIST.LOAD(VAL.FVAR,"CM.STATUS","2",'',STATUS.LIST,STATUS.IDX,LIST.COUNT,EMSG)
**IF EMSG <> "" THEN GOTO EXIT.999

GOSUB Setup_New_Cust

CRT "Run the gui loop"
DONE = 0
*
* The all important scheduler loop, rem sd "controls" execution of the python gui script
*  The VM owns the main execution loop
*  The SD runtime polls I/O through PY_PYPOLL()


loop while DONE = 0


*
*   give the gui some execution time (we execute one pass of function gui_step defined in our python setup script)
*
  STATUS.VALUE = PY_PYGUISTEP()
  if STATUS() # 0 then
    crt "PyGUI step failed: ":STATUS()
    DONE = 1
  END ELSE
*
*  now poll to see if the gui scheduled an event to process
*
    EVENT = PY_PYPOLL()
    if STATUS() = 0 then
      EVENT.NAME = FIELD(EVENT,@FM, 1)
      
      EVENT.DATA = FIELD(EVENT,@FM, 2)
      crt "GUI EVENT"
      crt "  NAME: ":EVENT.NAME
      crt "PAYLOAD: ":EVENT.DATA
      
      if EVENT.NAME = "main_window" and EVENT.DATA = "closed" then
        DONE = 1
        exit      ;* get out of loop
      end
      
      begin case            
      case  EVENT.NAME = "Get" 
        gosub Get.CM(CM_REC,CM_ID,CS_REC,CS_ID)

      case EVENT.NAME = "File" 
        gosub File.CM(CM_REC,CM_ID,CS_REC,CS_ID)
          
      case (EVENT.NAME = "New") or (EVENT.NAME = "Cancel")
        gosub Setup_New_Cust
          
      case 1 ;* unknown event
          MSG = 'Status: EVENT - ': EVENT.NAME : ' Not Implemented!'
          result = PY_GUIWINUPDATE("main_window","-STATUS-",MSG)
      end case
        
    end     ;* poll failed, try again?
  end
repeat

SHUTDOWN:
crt "sd CM.BP app ended: ":STATUS.VALUE


********************************************************************************************************
* pop_dict
* populated dictionary records for passed file
* pop_fn - file to reference
* pop_dict_name - dyn array of dictionary names
* note: because we cannot dynamically resize arrays passed in a local sub we use global variables arrays
*  global_dict_array
local subroutine pop_dict(pop_fn, pop_dict_name)

    open "DICT", pop_fn to dict_f then
        dict_ct = dcount(pop_dict_name,@FM)
        for pi = 1 to dict_ct
            read global_dict_array(pi) from dict_f, pop_dict_name<pi> else
                global_dict_array(pi) = '-NOF-'
            end
        next pi
    end
    return
end

*******************************************************************************************************
* values_load
* populate EXISTING! window objects values parameter
* val_window - window name
* val_obj_key - window object key
* val_list_name - EXISTING python list name
* val_dyn_list  - vm list of items to load into val_list_name, then update val_window object val_obj_key
*
local function values_load(val_window,val_obj_key,val_list_name,val_dyn_list)
  rtn_stat = 0
  rtn_stat = PY_LISTCLR(val_list_name)     ;* clear our list, Rem this is a known list name in CM.PY
  if rtn_stat = 0 then
    rtn_stat = PY_LISTAPPDS(val_list_name, val_dyn_list)
    if rtn_stat = 0 then
      rtn_stat = PY_GUIWINUPDVALUES(val_window,val_obj_key,val_list_name)
    end
  end
  return rtn_stat
end
******************************************************************************************************
* CM_LIST_LOAD
* load customer ids into dropdown on gui form
* sets rtn_stat
local subroutine CM_LIST_LOAD
* GET CUSTOMERS
CALL GUI.SEARCH2 ("CUSTOMERS","","","CM_NAME":@FM:"":@FM:'WITH CM_STATUS = "A"',"CM_NAME",1000,1,CM_LIST,CM_LIST_IDX,CM_LIST_CT,"TRIM",EMSG)

* now populate our lists
*
* load values into drop down list with key 'CM_LIST'
*
rtn_stat = values_load("main_window",'CM_LIST','MY_CM_LIST',CM_LIST)
if rtn_stat # 0 then
    crt "Customer List Load failed: ":STATUS()
end
return
end

******************************************************************************************************
* Setup_New_Cust
*
local subroutine Setup_New_Cust

 CM.REC = ''
 CM_ID = ''
 release CM_FILE
 CS_REC = ''
 CS_ID = ''
 release CS_FILE
 *gosub New.CM(CM.REC,CS_REC)

return
end

******************************************************************************************************
* File.CM
* Save the CM Record along 
* Pull data back from GUI
* Validate
* Write the records
* Refresh the GUI ??
******************************************************************************************************
local subroutine File.CM(CM_REC,CM_ID,CS_REC,CS_ID)
* grab the values from the GUI
* and populate CUSTOMER and SHIP_TO record.
* Rem this is a demo program, very little if any data validation is taking place!!!!
*
* use function readwindow to create a dyn array of keys and values
* screen_data<1> = keys in vm list
* screen_data<2> = values in vm list,
* note table date will be of the forme
* row 1 col1 @tm col2 @tm col3 @svm
* row 2 col1 @tm col2 @tm col3 @svm
* and so on
* 
* use function readwindow to get keys and values into string "screen_data"
rtn_stat = PY_CALLFUNCTION("readwindow","screen_data","main_window")

if rtn_stat = 0 then
  MAT TABLES = '' ;* used for building customer table data
* now get the string readwindow created
  window_data = PY_STRGET("screen_data")
  
  ** gosub display_file_data(window_data)   ;* for debugging
  
  keyct = dcount(window_data<1>, @vm)
  valcnt = dcount(window_data<2>, @vm)
  if keyct <> valcnt then
    msg =  'Value and Key count mismatch in File.CM, cannot file'
    crt msg
    result = PY_GUIWINUPDATE("main_window","-STATUS-",msg)
    
  end else
  *
  * loop thru defined key list and get the value
  *
  * CUSTOMER data first, the SHIP_TO
    for i = 1 to CM_SIZE
      key = CM_KEY_NAME<i,1>
      table_nbr = CM_KEY_NAME<i,2> + 0
      col_nbr   = CM_KEY_NAME<i,3> + 0

      locate key in window_data<1,1> setting idx else
        msg =  'Key lookup failure: ':key:' for CUSTOMERS in File.CM, cannot file'
        crt msg
        result = PY_GUIWINUPDATE("main_window","-STATUS-",msg) 
        return
      end
      
      * get the value sent back from the GUI
      data = window_data<2,idx>
      
      if table_nbr then
        * deal with table data
        * at some point i want a generic routine that deals with tables, for now its kind of file specific
        *CM_KEY_NAME<CM_CONTACT> =       "CM_CONTACT":@VM:1:@VM:1
        *CM_KEY_NAME<CM_CONTACT_PHONE> = "CM_CONTACT":@VM:1:@VM:2
        *CM_KEY_NAME<CM_CONTACT_EMAIL> = "CM_CONTACT":@VM:1:@VM:3
        * deal with table data
        * col_nbr tells us where the data for this record field resides within the value for this key
        * also rem its in the form:  row 1  col1 data @TM col2 data @TM col3 data @svm
        *                            row 2  col1 data @TM col2 data @TM col3 data @svm
        *                            row n  col1 data @TM col2 data @TM col3 data
        if TABLES(table_nbr) = '' then    ;* we have not pulled data for this table, do it
          tdata = data
          * convert value markers to allow dyn array use
          convert @svm to @fm in tdata
          convert @tm  to @vm in tdata
          TABLES(table_nbr) = tdata   ;* and save for use for balance of table deconstuction
        end
        *
        * pull this fld data from TABLES
        flddata = ''
        rowct = dcount(tdata,@fm)
        for ri = 1 to rowct
          if CM_DICT(i)<3> # '' then    ;* there is a conversion code
            flddata<1,-1> = iconv(tdata<ri,col_nbr>,CM_DICT(i)<3>)
          end else
            flddata<1,-1> = tdata<ri,col_nbr>
          end
        next ri
        CM_REC<i> = flddata
           
      end else
        * normal data, just populate fld
        if CM_DICT(i)<3> # '' then    ;* there is a conversion code
          CM_REC<i> = iconv(data,CM_DICT(i)<3>)
        end else
          CM_REC<i> = data
        end
      end
      
    next i

    * now the SHIP_TO
    for i = 1 to CS_SIZE
      key = CS_KEY_NAME<i,1>
      table_nbr = CS_KEY_NAME<i,2> + 0
      col_nbr   = CS_KEY_NAME<i,3> + 0

      locate key in window_data<1,1> setting idx else
        msg =  'Key lookup failure:' :key:' for SHIP_TO in File.CM, cannot file'
        crt msg
        result = PY_GUIWINUPDATE("main_window","-STATUS-",msg) 
        return
      end
      
      * get the value sent back from the GUI
      data = window_data<2,idx>
      
      if table_nbr then
        null ;* there are no tables defined in the SHIP_TO record 
      end else
        * normal data, just populate fld
        if CS_DICT(i)<3> # '' then    ;* there is a conversion code
          CS_REC<i> = iconv(data,CS_DICT(i)<3>)
        end else
          CS_REC<i> = data<1,vmi>
        end
      end  

    next i
    *
    * Need to validate records !!
    *

    * Is this a new customer record?
    if CM_ID = "" then
      * yes, get the next ids
      readu nxt_id from ID_FILE, "CUSTOMERS" locked
        locked_by = status()
        MSG = 'Status:  NEXT_ID Locked By User:' :locked_by :' Try later'
        result = PY_GUIWINUPDATE("main_window","-STATUS-",MSG) 
        return
      end then
        CM_ID = 'CM_':nxt_id
        nxt_id += 1
        write nxt_id on ID_FILE, "CUSTOMERS"
      end else
        MSG = 'Status:  Unable to Read NEXT_ID, see Admin!'
        result = PY_GUIWINUPDATE("main_window","-STATUS-",MSG) 
        return
      end
    end
     
    crt 'Validate Records Not Implemented!!!!'
      
    write CM_REC on CM_FILE, CM_ID
    write CS_REC on CS_FILE, CS_ID
    
    * clear data from the GUI
    rtn_str = PY_CALLFUNCTIONS("reset_form","main_window")
    
    * reset the values saved on the last Get (Rec Change Test)
    rtn_str = PY_CLEARDICT("ValuesOnGet")
    
    * let user know data was written
    msg =  'Customer Record: ':CM_ID:' Updated'
    crt msg
    result = PY_GUIWINUPDATE("main_window","-STATUS-",msg)

  end  ;* keyct <> valcnt
*
end else
  crt 'readwindow failed'
end

return
end
********************************************************************************
* display what we got back from the GUI
* for debugging only
*******************************************************************************
local subroutine display_file_data(window_data)
  keyct = dcount(window_data<1>, @vm)
  valcnt = dcount(window_data<2>, @vm)
  crt 'counts: ':keyct: ' ' :valcnt
  crt 'keys / values: '
  for i = 1 to keyct
    crt window_data<1,i>:': ':
    * test for table (@TM in data)
    val = window_data<2,i>
    if count(val,@TM)  then  ;* looks like table data
      crt
      rowct =  dcount(val,@svm) ;* row data separated by svm
      for r = 1 to rowct
        row = window_data<2,i,r>
        cname = field(row,@TM,1)
        cphone = field(row,@TM,2)
        cemail = field(row,@TM,3)
        crt cname: ' ': cphone : ' ' : cemail 
      next r
      crt
      
    end else
      crt window_data<2,i>
    end      
  next i
return
end

******************************************************************************************************
* get.cm
* get cm record and populate window with values
local subroutine Get.CM (CM_REC,CM_ID,CS_REC,CS_ID)
CM.REC = ''
CS_REC = ''
MAT TABLES = ''  ;* used for building customer table data

* Get the currently selected customer id from the GUI
* note cannot use this CM_ID = PY_DICTVALGETS("values","CM_LIST")
* when processing PUP_pending_event, must read from main_window
*
rtn_stat = PY_CALLFUNCTION("read_cm_key","screen_data","main_window")
CM_ID = PY_STRGET("screen_data")
CM_ID = trim(field(CM_ID,":",1))

if CM_ID = '' then
  MSG = 'Status: No Customer Id Found'
  result = PY_GUIWINUPDATE("main_window","-STATUS-",MSG)
end else
  * if we had a previous lock on a CUSTOMERS record, release it
  release CM_FILE
  readu CM_REC from CM_FILE, CM_ID locked
      locked_by = status()
      MSG = 'Status: ': CS_ID : 'Locked By User:' :locked_by :' Try later'
      result = PY_GUIWINUPDATE("main_window","-STATUS-",MSG)
              
  end then
      CS_ID = CM_REC<CM_DFLT_SHIP_ID>
      read CS_REC from CS_FILE, CS_ID else
          MSG = 'Status: ': CS_ID : ' Not Found in SHIP_TO!'
          result = PY_GUIWINUPDATE("main_window","-STATUS-",MSG)
      end
      * populate window with customer data 
      key_list = ''
      value_list = ''
      for i = 1 to CM_SIZE
        table_nbr = CM_KEY_NAME<i,2> + 0 
        * is this a data item that belongs in a table?
        if table_nbr > 0 then
        * yes (rem this means the field is multi value)
        if table_nbr > MAX_TABLES then
          CRT 'Resize Tables Array!'
          return 
        end
        
          tbl_name = upcase(CM_KEY_NAME<i,1>)
          fld_loc = CM_KEY_NAME<i,3> + 0       ;* defines col position in table
          
        *CM_KEY_NAME<CM_CONTACT> =       "CM_CONTACT":@VM:1:@VM:1
        *CM_KEY_NAME<CM_CONTACT_PHONE> = "CM_CONTACT":@VM:1:@VM:2
        *CM_KEY_NAME<CM_CONTACT_EMAIL> = "CM_CONTACT":@VM:1:@VM:3
        
          data = CM_REC<i>
          
          vm_count = dcount(data,@VM)
          
          for vmi = 1 to vm_count
            if CM_DICT(i)<3> # '' then    ;* there is a conversion code
              tdata = oconv(data<1,vmi>,CM_DICT(i)<3>)
            end else
              tdata = data<1,vmi>
            end
            TABLES(table_nbr)<1,vmi,fld_loc> = tdata
          next vmi
        
        end else                    
          data = CM_REC<i>
          if CM_DICT(i)<3> # '' then    ;* there is a conversion code
            data = oconv(data,CM_DICT(i)<3>)
          end
          value_list<1,-1> = data
          key_list<1,-1>   = CM_KEY_NAME<i>
        end
      next i
      * 
      * and now the default ship to
      for i = 1 to CS_SIZE
        * note: 
        * there are not tables in ship_to record so why is this here??
        if upcase(CS_DICT(i)<6>) = "M" then
          * multi value field and most likely added to table, skip for now
          null    
        end else
          data = CS_REC<i>
          if CS_DICT(i)<3> # '' then    ;* there is a conversion code
            data = oconv(data,CS_DICT(i)<3>)
          end
          value_list<1,-1> = data
          key_list<1,-1>   = CS_KEY_NAME<i>
        end
      next i
      *
      * load the ship_to list
      *
      SHIPTO_LIST = ''  
      SHIPTO_LIST_IDX  = ''
      SHIPTO_LIST_CT = 0
      *
      * get the dropdown list for ship_to records for this customer                
       CALL GUI.SEARCH2 ("SHIP_TO","CS_CM_ID",'!':CM_ID,"CS_NAME","CS_ADDR,CS_CITY,CS_STATE",1000,1,SHIPTO_LIST,SHIPTO_LIST_IDX,SHIPTO_LIST_CT,"TRIM",EMSG)
      * load values into drop down list with key 'CM_LIST'
      *CRT 'shipto_list: ' : SHIPTO_LIST
      rtn_stat = values_load("main_window",'CS_LIST','MY_CS_LIST',SHIPTO_LIST)
      if rtn_stat = 0 then
        * load the customer data (including ship to) except for tables
        rtn_stat = PY_GUIWINUPDATES("main_window",key_list,value_list)
        
        if rtn_stat = 0 then
        * attempt to load the table data, rem tables are lists of lists, must clear existing list or we end up appending
          rtn_stat = PY_LISTCLR("CUST_CONTACTS")
          * load the list that will load the customer contacts table (note we are cheating here, this is not generic)
          rtn_stat1 = PY_GUITABLESET("CUST_CONTACTS",TABLES(1))
          * finally load the actual table data (key: CM_CONTACT, values is list CUST_CONTACTS)
          rtn_stat2 = PY_GUIWINUPDVALUES("main_window","CM_CONTACT","CUST_CONTACTS")
          if rtn_stat + rtn_stat1 + rtn_stat2 <> 0 then
            MSG = 'Status: ': CM_ID :' Table Load Failed: ':rtn_stat:' ':rtn_stat1:' ':rtn_stat2
            result = PY_GUIWINUPDATE("main_window","-STATUS-",MSG)
          end else
              * take a snapshot of the current values on the screen
              * we use this to test for data change and save ("file") required
              rtn_stat = PY_CALLFUNCTION("snapshot","ValuesOnGet","main_window")
              *rtn_stat = PY_POPUP("create_popup", "PUP_window", "PUP_title", "Get CM Title", "PUP_message", "CM Loaded","PUP_style",PY_PUP_OK)
          end
          
        end else
          * customer data load failed
          MSG = 'Status: ': CM_ID :' Load Failed: ':rtn_stat
          result = PY_GUIWINUPDATE("main_window","-STATUS-",MSG)
        end
      end else
        crt "SHIP_TO List Load failed: ":STATUS()
        MSG = 'Status: SHIP_TO List Load failed: ':rtn_stat
        result = PY_GUIWINUPDATE("main_window","-STATUS-",MSG) 
      end
      *
  end else
          MSG = 'Status: ': CM_ID :' Not Found in CUSTOMERS!'
          result = PY_GUIWINUPDATE("main_window","-STATUS-",MSG)
  end
end
return
end

local subroutine cm.shipto.validate
*
*
* VALIDATE THE CM RECORD
* RETURNS CM.REC.VALID T/F
*
CM.SHIPTO.VALID = @TRUE
CM.VALIDATE.MSG = ''
*
BEGIN CASE
*
   CASE  CM_REC<CM_STATUS> = ''
      CM.VALIDATE.MSG = 'Customer status is a required field'
*
   CASE CM_REC<CM_NAME> = ''
      CM.VALIDATE.MSG = 'Customer name is a required field'
*
   CASE CM_REC<CM_ADDR> = ''
      CM.VALIDATE.MSG = 'Customer street address is a required field'
*
   CASE CM_REC<CM_CITY> = ''
      CM.VALIDATE.MSG = 'Customer city is a required field'
*
   CASE  CM_REC<CM_STATE> = ''
      CM.VALIDATE.MSG = 'Customer state is a required field'
*
   CASE  CM_REC<CM_ZIP> = ''
      CM.VALIDATE.MSG = 'Customer zip code is a required field'
*
   CASE  CM_REC<CM_TERMS> = ''
      CM.VALIDATE.MSG = 'Customer payment terms'
*
   CASE  CM_REC<CM_AR_LIMIT> < 0
      CM.VALIDATE.MSG = 'Customer credit limit must be >= 0'
*
*
* VALIDATE SHIP TO RECORD ALSO
*
*
   CASE CS_REC<CS_NAME> = ''
      CM.VALIDATE.MSG = 'Ship to name is a required field'
*
   CASE CS_REC<CS_ADDR> = ''
      CM.VALIDATE.MSG = 'Ship to street address is a required field'
*
   CASE CS_REC<CS_CITY> = ''
      CM.VALIDATE.MSG = 'Ship to city is a required field'
*
   CASE  CS_REC<CS_STATE> = ''
      CM.VALIDATE.MSG = 'Ship to state is a required field'
*
   CASE  CS_REC<CS_ZIP> = ''
      CM.VALIDATE.MSG = 'Ship to zip code is a required field'
   
   CASE  CS_REC<CS_STATUS> = ''
      CM.VALIDATE.MSG = 'Customer Ship To status is a required field'
*

END CASE
return
end

9999:  *
end
* END-CODE