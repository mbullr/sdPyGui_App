* CM.BP
* Customer App
* Sample app for PyGui testing on sd
* We should define windows within a function to ensure objects used during creation (the layout) get garbage collected
*  (the _setup.py script)
* Because we are running embedded within the sd app and it is possible the sd process could be alive for long periods of
*  time, we should clean up (set to None) any objects created either within the _setup.py or _step.py script.
* Also at some point the sd Python function PY_PYGUISTEP()  (sd_py_gui_step in sdext_py.c) should be passed the name of #  *   the function defined in the _step.py script (in this example gui_step).  Currently it is hardcoded. 

$include KEYS.H
$include SDPYFUNC.H

* These should be generated using the sd GENERATE command. For now we are doing this manually
* Also may want to modify GENERATE for create the xx_DICT dyn arrays

equate CM_NAME to 1
equate CM_ADDR          to    2
equate CM_ADDR2         to    3
equate CM_CITY          to    4
equate CM_STATE         to    5
equate CM_ZIP           to    6
equate CM_COUNTRY       to    7
equate CM_STATUS        to    8
equate CM_AR_LIMIT      to    9
equate CM_TERMS         to    10
equate CM_PHONE         to    11
equate CM_FAX           to    12
equate CM_WEB           to    13
equate CM_CONTACT       to    14
equate CM_CONTACT_PHONE to    15
equate CM_CONTACT_EMAIL to    16
equate CM_DFLT_SHIP_ID  to    17
equate CM_SIZE  to    17

equate CS_NAME to 1
equate CS_ADDR          to    2
equate CS_ADDR2         to    3
equate CS_CITY          to    4
equate CS_STATE         to    5
equate CS_ZIP           to    6
equate CS_COUNTRY       to    7
equate CS_STATUS        to    8
equate CS_PHONE         to    9
equate CS_FAX           to    10
equate CS_SIZE to    10

DIM CM_DICT(CM_SIZE)
CM_DICT_NAME = ''
CM_DICT_NAME<CM_NAME> = "CM_NAME"
CM_DICT_NAME<CM_ADDR> = "CM_ADDR"
CM_DICT_NAME<CM_ADDR2> = "CM_ADDR2"
CM_DICT_NAME<CM_CITY> = "CM_CITY"
CM_DICT_NAME<CM_STATE> = "CM_STATE"
CM_DICT_NAME<CM_ZIP> = "CM_ZIP"
CM_DICT_NAME<CM_COUNTRY> = "CM_COUNTRY"
CM_DICT_NAME<CM_STATUS> = "CM_STATUS"
CM_DICT_NAME<CM_AR_LIMIT> = "CM_AR_LIMIT"
CM_DICT_NAME<CM_TERMS> = "CM_TERMS"
CM_DICT_NAME<CM_PHONE> = "CM_PHONE"
CM_DICT_NAME<CM_FAX> = "CM_FAX"
CM_DICT_NAME<CM_WEB> = "CM_WEB"
CM_DICT_NAME<CM_CONTACT> = "CM_CONTACT"
CM_DICT_NAME<CM_CONTACT_PHONE> = "CM_CONTACT_PHONE"
CM_DICT_NAME<CM_CONTACT_EMAIL> = "CM_CONTACT_EMAIL"
CM_DICT_NAME<CM_DFLT_SHIP_ID> = "CM_DFLT_SHIP_ID" 


DIM CS_DICT(CS_SIZE)
CS_DICT_NAME = ''
CS_DICT_NAME<CS_NAME> = "CS_NAME"
CS_DICT_NAME<CS_ADDR> = "CS_ADDR"
CS_DICT_NAME<CS_ADDR2> = "CS_ADDR2"
CS_DICT_NAME<CS_CITY> = "CS_CITY"
CS_DICT_NAME<CS_STATE> = "CS_STATE"
CS_DICT_NAME<CS_ZIP> = "CS_ZIP"
CS_DICT_NAME<CS_COUNTRY> = "CS_COUNTRY"
CS_DICT_NAME<CS_STATUS> = "CS_STATUS"
CS_DICT_NAME<CS_PHONE> = "CS_PHONE"
CS_DICT_NAME<CS_FAX> = "CS_FAX"

* rem to point these to where you save the python scripts
SETUP.FILE = "/home/sd/user_accounts/mabull/BP/CM_setup.py"
STEP.FILE = "/home/sd/user_accounts/mabull/BP/CM_step.py"


* do the files exist?
OPEN "CUSTOMERS" TO CM_FILE ELSE
  CRT 'CANNOT CREATE CUSTOMERS'
  STOP
END
OPEN "SHIP_TO" TO CS_FILE ELSE
  CRT 'CANNOT CREATE SHIP_TO'
  STOP
END

* get the dictionaries
GOSUB pop_dict("CUSTOMERS",CM_DICT_NAME,MAT CM_DICT)

STATUS.VALUE = PY_INITIALIZE()
IF STATUS() # 0 THEN
    crt "Python initialization failed: ":STATUS()
    STOP
END


STATUS.VALUE = PY_RUNFILE(STEP.FILE)
IF STATUS() # 0 THEN
    crt "PyGui step setup failed: ":STATUS()
    GOTO SHUTDOWN
END

CRT "Setup Gui Window"

STATUS.VALUE = PY_RUNFILE(SETUP.FILE)
IF STATUS() # 0 THEN
    crt "PYGui setup failed: ":STATUS()
    GOTO SHUTDOWN
END


CRT "Run the gui loop"
DONE = 0
counter = 0
LOOP WHILE DONE = 0
    counter += 1
    STATUS.VALUE = PY_PYGUISTEP()
    IF STATUS() # 0 THEN
        crt "Tkinter step failed: ":STATUS()
        DONE = 1
    END ELSE
        EVENT = PY_PYPOLL()
        IF STATUS() = 0 THEN
            EVENT.NAME = FIELD(EVENT,@FM, 1)
            * just prove that the cooperative scheduler is coming back at a regular interval 
            if EVENT.NAME = '__TIMEOUT__' then
              if counter > 1000 then
                crt '1000 timeouts'
                counter = 0
              end
            end else
              EVENT.DATA = FIELD(EVENT,@FM, 2)
              crt "GUI EVENT"
              crt "  NAME: ":EVENT.NAME
              * there is a size limit to the payload, perhaps only send the key values then get them from python one at a time?
              crt "  DATA: ":EVENT.DATA
              
              if EVENT.NAME = "-OK-" then
              
                key_list = PY_DICTGETKEYS("values")  ;* returns tab separated list of keys
                *crt "PY_DICTGETKEYS status: ":status()
                *crt "key_list: ":key_list
                key_ct = dcount(key_list,@fm)
                EVENT.DATA = ''
                for i = 1 to key_ct
                  key = key_list<i>
                  if key = "-TEXTBX-" then
                    null
                  end else
                    value = PY_DICTVALGETS("values",key)
                    *crt "key: ":key
                    *crt "value: ":value
                    EVENT.DATA := key:':':value : char(10)
                    *crt
                  end
                next i
              
              
                Key_list = '-UNAME-':@VM: '-DOB-' :@VM :'-ACCOUNT-' :@VM: "-TEXTBX-"
                Value_list = 'UserName':@VM: 'Birth Date' :@VM :'' :@VM: EVENT.DATA 
                result = PY_GUIWINUPDATES("main_window",Key_list,Value_list)   
              
                *result = PY_GUIWINUPDATE("main_window","-TEXTBX-",EVENT.DATA)
                crt "window update result: ":result
              end
              
              IF EVENT.NAME = "main_window" AND EVENT.DATA = "closed" THEN
                DONE = 1
              END
            end
        END
    END
REPEAT

SHUTDOWN:
crt "SD FreeSimpleGUI demo ended: ":STATUS.VALUE


********************************************************************************************************
* pop_dict
* populated dictionary records for passed file
* pop_fn - file to reference
* pop_dict_name - dyn array of dictionary names
*
local subroutine pop_dict(pop_fn, pop_dict_name, mat dict_array)
    dim dict_array(1)
    open "DICT", pop_fn to dict_f then
        dict_ct = dcount(pop_dict_name,@FM)
        for pi = 1 to dict_ct
            read dict_array(i) from dict_f, pop_dict_name<pi> else
                dict_array(i) = '-NOF-'
            end
        next pi
    end
    return    
end

9999:  *
end
* END-CODE